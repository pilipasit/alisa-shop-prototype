# Cloudflare Pages response headers — https://developers.cloudflare.com/pages/configuration/headers/
# These are the headers GitHub Pages could NOT set. They only take effect on Cloudflare Pages.

/*
  # Force HTTPS for a year. Remove `includeSubDomains` if you ever need a plain-HTTP
  # subdomain. Add `; preload` only when you're sure — preload is hard to undo.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Don't let browsers guess a file's type (blocks a class of injection tricks).
  X-Content-Type-Options: nosniff

  # Don't leak the full URL (with query params) to other sites.
  Referrer-Policy: strict-origin-when-cross-origin

  # Block framing — stops clickjacking / someone embedding the shop in their page.
  X-Frame-Options: DENY

  # Turn off browser features the shop never uses.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()

  # Same policy as the in-page <meta> CSP, plus the two directives a meta tag cannot express.
  # connect-src includes the order Worker so the checkout can reach it — pinned to the
  # exact host rather than a *.workers.dev wildcard.
  # This site-wide policy stays loose ONLY for the design-system cards (components/, guidelines/,
  # ui_kits/presentation|retail-materials|social), which still compile JSX in the browser.
  # The shop itself is a production build (tools/build.mjs) and gets the strict policy below on top:
  # when two CSP headers apply, the browser enforces both, i.e. the stricter one wins.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com 'unsafe-inline' 'unsafe-eval'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' https://alisa-orders.mrsupetbred.workers.dev; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# The shop and the landing page: scripts only from this site — no CDN, no inline scripts, no eval.
/ui_kits/webshop/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' https://alisa-orders.mrsupetbred.workers.dev; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# Product photos and logos change rarely — cache them for a week.
/assets/*
  Cache-Control: public, max-age=604800

# The shop's code is still being iterated: keep it short so updates appear quickly.
# (This is also why editing a .jsx needed a hard-refresh on GitHub Pages' 10-minute cache.)
/ui_kits/*
  Cache-Control: public, max-age=300, must-revalidate
